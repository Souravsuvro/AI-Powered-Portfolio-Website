# Copy values into .env.local (Vite) and Vercel Environment Variables.
# Leave blank → site continues to work with localStorage only.

# Public (safe for browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only (Vercel / api routes) — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Existing AI key (unchanged)
XAI_API_KEY=xai-...
